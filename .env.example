# =============================================================================
# ELS Financial Planning — Environment Variables
# =============================================================================
# Copy this file to .env for local development.
# For Vercel: set these in the Vercel dashboard under Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL — required for production)
# -----------------------------------------------------------------------------

# Option A: Vercel Postgres (Neon) — auto-injected when you add Vercel Postgres
# to your project. Copy these from the Vercel dashboard Storage tab.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/els_fpa?schema=public"

# For Vercel Postgres (Neon), this is the non-pooled connection used by Prisma
# for schema migrations. Set this alongside DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/els_fpa?schema=public"

# Option B: Local development with SQLite (no DIRECT_URL needed):
# DATABASE_URL="file:./prisma/dev.db"
# (comment out DIRECT_URL or leave it unset for SQLite)

# Option C: External providers (Supabase, Railway, Neon standalone):
# DATABASE_URL="postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:password@host:5432/dbname?connect_timeout=15"

# -----------------------------------------------------------------------------
# Application Security — REQUIRED
# Set a cryptographically random string (min 32 chars) in Vercel dashboard.
# Generate one with: openssl rand -hex 32
# -----------------------------------------------------------------------------
SESSION_SECRET="super-secret-session-key-at-least-32-chars-long-for-production"
COOKIE_NAME="els_fpa_session"

# -----------------------------------------------------------------------------
# Runtime Environment
# -----------------------------------------------------------------------------
NODE_ENV="development"

# Logging level: debug | info | warn | error
LOG_LEVEL="info"
