# Database Configuration
# PostgreSQL (Default production & development target):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/els_fpa?schema=public"

# If using SQLite for hermetic local testing/development:
# DATABASE_URL="file:./dev.db"

# Application Security
SESSION_SECRET="super-secret-session-key-at-least-32-chars-long-for-production"
COOKIE_NAME="els_fpa_session"
NODE_ENV="development"

# Logging Configuration
LOG_LEVEL="info"
